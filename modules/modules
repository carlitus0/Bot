    await member.add_roles(role)

# =========================
# LOOP SYSTEM
# =========================

@bot.command()
@commands.has_permissions(administrator=True)
async def loop(ctx, command_name, seconds=60):

    if command_name in loop_tasks:
        return await ctx.send("Loop já ativo")

    async def task():
        while True:
            cmd = bot.get_command(command_name)
            if not cmd:
                break
            try:
                await ctx.invoke(cmd)
            except:
                pass
            await asyncio.sleep(seconds)

    loop_tasks[command_name] = asyncio.create_task(task())
    await ctx.send("Loop iniciado")

@bot.command()
@commands.has_permissions(administrator=True)
async def stoploop(ctx):
    for t in loop_tasks.values():
        t.cancel()
    loop_tasks.clear()
    await ctx.send("Loops parados")

# =========================
# UTIL
# =========================

